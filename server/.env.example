# SXRON authentication
# Owner client ID: set the persistent client ID used by the owner desktop.
SXRON_OWNER_CLIENT_ID=
SXRON_OWNER_EMAIL=neoneonhorizon@gmail.com
SXRON_OWNER_USERNAME=Nikitinka7644

# Comma-separated frontend origins. Use * for a simple single-backend setup.
SXRON_CORS_ORIGINS=*

# Persistent database directory.
SXRON_DATA_DIR=./data
PORT=8000

# Verification code settings.
SXRON_AUTH_CODE_TTL=300
SXRON_AUTH_RESEND_SECONDS=60
SXRON_AUTH_MAX_ATTEMPTS=5
SXRON_AUTH_SESSION_DAYS=30
SXRON_AUTH_SESSION_HOURS=12
SXRON_AUTH_DEBUG=false

# Owner password-recovery reset token lifetime.
SXRON_OWNER_RECOVERY_TTL=900

# Email provider. Use console only for local development/testing.
SXRON_EMAIL_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# SMS provider. Twilio is used in production; console is for local testing.
SXRON_SMS_MODE=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
