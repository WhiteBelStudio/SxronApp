{
  "name": "sxron-marketplace",
  "version": "1.2.4",
  "description": "SXRON Marketplace",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "android": "npm run build && cap sync android && cap open android",
    "android:build": "npm run build && cap sync android && cd android && gradlew.bat assembleDebug",
    "cap:sync": "npm run build && cap sync",
    "ios": "npm run build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "axios": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.sxron.marketplace",
    "productName": "SXRON Marketplace",
    "directories": {"output": "release"},
    "files": ["dist/**/*", "electron/**/*", "server-dist/**/*", "package.json"],
    "extraResources": [
      {
        "from": "backend/sxron-api",
        "to": "backend/sxron-api"
      }
    ],
    "win": {"target": "nsis", "icon": "build/sxron-icon.svg", "artifactName": "SXRON-Marketplace-Setup-${version}-${arch}.${ext}"},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true},
    "publish": [{"provider": "github", "owner": "WhiteBelStudio", "repo": "SxronApp", "releaseType": "release"}]
  }
}
