{
  "name": "sxron-marketplace",
  "private": true,
  "version": "1.0.8",
  "description": "SXRON Marketplace v1.0.8 — unified web, desktop and mobile client",
  "author": "WhiteBelStudio",
  "repository": { "type": "git", "url": "https://github.com/WhiteBelStudio/SxronApp.git" },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm run api:dev\"",
    "api:dev": "python -m uvicorn server.main:app --reload --host 127.0.0.1 --port 8000",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "app:dev": "concurrently -k \"vite\" \"npm run api:dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "app:build": "npm run build && electron-builder --publish never",
    "android": "npm run build && cap sync android && cap open android",
    "ios": "npm run build && cap sync ios && cap open ios",
    "cap:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "electron-updater": "^6.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.sxron.marketplace",
    "productName": "SXRON Marketplace",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "extraResources": [{ "from": "backend/sxron-api.exe", "to": "backend/sxron-api.exe" }],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "SXRON-Marketplace-${version}-${arch}.${ext}"
    },
    "nsis": {
      "artifactName": "SXRON-Marketplace-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SXRON Marketplace",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "include": "build/installer.nsh"
    },
    "portable": { "artifactName": "SXRON-Marketplace-Portable-${version}-${arch}.${ext}" },
    "fileAssociations": [{
      "ext": "sxron",
      "name": "SXRON Marketplace file",
      "description": "Файл SXRON Marketplace",
      "role": "Editor"
    }],
    "protocols": [{ "name": "SXRON Marketplace", "schemes": ["sxron"] }],
    "publish": [{ "provider": "github", "owner": "WhiteBelStudio", "repo": "SxronApp", "releaseType": "release" }]
  }
}
