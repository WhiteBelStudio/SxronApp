# Public SXRON API base URL.
# Local development:
# VITE_API_URL=http://127.0.0.1:8000
# Production:
# VITE_API_URL=https://your-sxron-api.example.com
VITE_API_URL=

# Optional SMTP defaults for the backend.
# SXRON_SMTP_PROVIDER can be: gmail, yandex, mailru, outlook, yahoo, proton, custom
# Credentials are intentionally not included in this repository.
# SXRON_SMTP_PROVIDER=gmail
# SXRON_SMTP_HOST=smtp.gmail.com
# SXRON_SMTP_PORT=587
# SXRON_SMTP_SECURITY=starttls
# SXRON_SMTP_USERNAME=your-email@example.com
# SXRON_SMTP_PASSWORD=your-app-password
# SXRON_SMTP_FROM=your-email@example.com
